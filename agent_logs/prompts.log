import argparse
import json
import re

def parse_input(file_path):
    with open(file_path, 'r') as file:
        return [line.strip() for line in file.readlines()]

def is_comment(line):
    return line.strip().startswith('#')

def parse_statement(line):
    if not line or is_comment(line):
        return None
    parts = line.split(':')
    if len(parts) != 2:
        raise ValueError(f"Malformed statement: {line}")
    keyword, value = parts
    keyword = keyword.strip()
    value = value.strip()
    return keyword, value

def expand_repeats(pattern_data):
    expanded_pattern = []
    current_repeat = []
    in_repeat = False
    repeat_count = 0
    repeat_index = -1

    for line in pattern_data:
        if line.startswith('repeat'):
            if not current_repeat or repeat_count > 0:
                raise ValueError(f"Malformed repeat block: {line}")
            in_repeat = True
            continue
        elif line.startswith('end'):
            if not in_repeat or repeat_index == -1:
                raise ValueError(f"Unmatched end statement: {line}")
            for _ in range(repeat_count):
                expanded_pattern.extend(current_repeat)
            current_repeat = []
            in_repeat = False
            repeat_count = 0
            continue
        elif in_repeat:
            current_repeat.append(line)
        else:
            match = re.match(r'(\d+)\s*(.*)', line)
            if not match:
                raise ValueError(f"Invalid row format: {line}")
            count, content = match.groups()
            expanded_pattern.extend([content] * int(count))
    return expanded_pattern

def simulate_stitches(pattern_data):
    stitch_counts = []
    current_count = 0
    for line in pattern_data:
        if line.startswith('pattern'):
            continue
        stitches = line.split(',')
        for stitch in stitches:
            stitch = stitch.strip()
            if not stitch:
                continue
            if stitch == 'k':
                current_count += 1
            elif stitch == 'p':
                current_count += 1
            elif stitch == 'yo':
                current_count += 2
            else:
                raise ValueError(f"Unknown stitch: {stitch}")
        stitch_counts.append(current_count)
    return stitch_counts

def main():
    parser = argparse.ArgumentParser(description='Knitting Compiler')
    parser.add_argument('compile', nargs=1, help='compile <input_file>')
    args = parser.parse_args()

    if len(args.compile) != 1:
        print("Error: Invalid number of arguments", file=sys.stderr)
        sys.exit(2)

    input_file = args.compile[0]
    try:
        pattern_data = parse_input(input_file)
        expanded_pattern = expand_repeats(pattern_data)
        stitch_counts = simulate_stitches(expanded_pattern)
        json_output = {
            "stitch_counts": stitch_counts
        }
        print(json.dumps(json_output, indent=4))
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()

